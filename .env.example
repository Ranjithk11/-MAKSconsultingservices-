# Public site URL used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# SQLite file. On a server, point this at a disk that survives restarts.
DATABASE_PATH=data/maks.db

# Studio desk. Required in production. Local development falls back to russell-studio.
MAKS_DESK_KEY=russell-studio

# Mail. Leave SMTP_HOST empty to queue letters in the desk outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MAKS Desk <desk@maksconsulting.in>"
MAIL_TO=desk@maksconsulting.in

# WhatsApp Cloud API. Leave blank to queue outbound messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Public number for the wa.me button, digits only, country code included.
NEXT_PUBLIC_WHATSAPP_E164=

# Shown on /api/health
HOSTING_PLATFORM=node
HOSTING_REGION=local
